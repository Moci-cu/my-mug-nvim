return {
  {
    "nvim-mini/mini.pick",
    dependencies = {
      "nvim-mini/mini.extra",
    },
    config = function()
      local pick = require("mini.pick")
      local extra = require("mini.extra")

      pick.setup({
        window = {
          config = {
            width = math.floor(vim.o.columns * 0.9),
            height = math.floor(vim.o.lines * 0.8),
          },
        },
      })

      extra.setup()

      -- Regex patterns from fzf-lua.lua.bak2
      local rules = {
        Golang = {
          Function = [[^func +(?:\([a-zA-Z0-9_]+ +\*?[a-zA-Z0-9_]+(?:\[.+\])?\))? *[A-Z][a-zA-Z0-9_]* -- !*test* ]],
          Type = [[^type +[A-Z][a-zA-Z0-9_]+ -- !*test* ]],
        },
        Rust = {
          Function_and_Macro = [[(^\s*pub (const )?(unsafe )?fn +[a-zA-Z0-9_#]+|^\s*macro_rules! [a-zA-Z0-9_#]+|^impl )]],
          Type = [[^\s*pub (?:struct|union|enum|trait|type) [a-zA-Z0-9_#]+]],
        },
        C = {
          Function = [[^[a-zA-Z_*][a-zA-Z0-9_* ]*\s+[a-zA-Z_][a-zA-Z0-9_]*\s*\(.*\)]],
          Struct = [[^struct\s+[a-zA-Z_][a-zA-Z0-9_]*\s*\{]],
          Typedef = [[^typedef\s+]],
          Enum = [[^enum\s+[a-zA-Z_][a-zA-Z0-9_]*\s*\{]],
          Union = [[^union\s+[a-zA-Z_][a-zA-Z0-9_]*\s*\{]],
        },
      }

      -- Regex grep function (like fzf-lua)
      local function regex_grep(pattern)
        if not pattern or pattern == "" then return end
        local handle = io.popen("rg --vimgrep --pcre2 '" .. pattern:gsub("'", "'\\''") .. "' 2>/dev/null")
        if not handle then return end
        local output = handle:read("*a")
        handle:close()

        local items = {}
        for line in output:gmatch("[^\n]+") do
          local file, lnum, col, text = line:match("^(.+):(%d+):(%d+):(.*)$")
          if file then
            table.insert(items, {
              text = line,
              file = file,
              lnum = tonumber(lnum),
              col = tonumber(col),
            })
          end
        end

        if #items == 0 then
          vim.notify("No matches found", vim.log.levels.INFO)
          return
        end

        pick.start({
          source = {
            items = items,
            name = "Regex grep",
            choose = function(item)
              if item and item.file then
                vim.schedule(function()
                  vim.cmd("edit " .. vim.fn.fnameescape(item.file))
                  if item.lnum then
                    vim.api.nvim_win_set_cursor(0, { item.lnum, item.col or 0 })
                  end
                end)
              end
            end,
          },
        })
      end

      -- Language options
      local lang_options = {
        Golang = {
          { name = "Function", action = function() regex_grep(rules.Golang.Function) end },
          { name = "Type",     action = function() regex_grep(rules.Golang.Type) end },
          { name = "Stdlib",   action = "stdlib" },
          { name = "Files",    action = function() pick.builtin.files() end },
          { name = "Any",      action = function() pick.builtin.grep_live() end },
        },
        Rust = {
          { name = "Function", action = function() regex_grep(rules.Rust.Function_and_Macro) end },
          { name = "Type",     action = function() regex_grep(rules.Rust.Type) end },
          { name = "Files",    action = function() pick.builtin.files() end },
          { name = "Any",      action = function() pick.builtin.grep_live() end },
        },
        C = {
          { name = "Function", action = function() regex_grep(rules.C.Function) end },
          { name = "Struct",   action = function() regex_grep(rules.C.Struct) end },
          { name = "Enum",     action = function() regex_grep(rules.C.Enum) end },
          { name = "Stdlib",   action = "stdlib" },
          { name = "Files",    action = function() pick.builtin.files() end },
          { name = "Any",      action = function() pick.builtin.grep_live() end },
        },
      }

      local function module_api_search()
        local detected = nil
        local ft = vim.bo.filetype
        if ft == "go" then
          detected = "Golang"
        elseif ft == "rust" then
          detected = "Rust"
        elseif ft == "c" then
          detected = "C"
        end

        if not detected then
          pick.start({
            source = {
              items = { "Files", "Any" },
              name = "Search",
              choose = function(item)
                if item == "Any" then
                  pick.builtin.grep_live()
                elseif item == "Files" then
                  pick.builtin.files()
                end
              end,
            },
          })
          return
        end

        local items = {}
        for _, item in ipairs(lang_options[detected]) do
          table.insert(items, item.name)
        end

        pick.start({
          source = {
            items = items,
            name = string.format("Search (%s)", detected),
            choose = function(item)
              for _, opt in ipairs(lang_options[detected]) do
                if opt.name == item then
                  if opt.action == "stdlib" then
                    local stdlib_cwd
                    if detected == "Golang" then
                      local goroot = vim.fn.system("go env GOROOT"):gsub("%s+", "")
                      stdlib_cwd = goroot .. "/src"
                    elseif detected == "C" then
                      stdlib_cwd = "/usr/include"
                    end
                    if stdlib_cwd then
                      pick.builtin.files({ source = { cwd = stdlib_cwd } })
                    end
                  else
                    opt.action()
                  end
                  return
                end
              end
            end,
          },
        })
      end

      -- Keymaps
      vim.keymap.set("n", "<leader>f", pick.builtin.files, { desc = "Files" })
      -- vim.keymap.set("n", "<C-g>", pick.builtin.grep, { desc = "Grep" })
      vim.keymap.set("n", "<leader>l", pick.builtin.grep_live, { desc = "Live grep" })
      vim.keymap.set("n", "<C-\\>", pick.builtin.buffers, { desc = "Buffers" })
      vim.keymap.set("n", "<C-k>", function()
        extra.pickers.lsp({ scope = "document_symbol" })
      end, { desc = "Document symbols" })
      vim.keymap.set("n", "<F1>", function()
        extra.pickers.lsp({ scope = "workspace_symbol" })
      end, { desc = "Workspace symbols" })
      vim.keymap.set("n", "<leader>s", module_api_search, { desc = "Module API search" })
    end,
  },
}
